    #include <stdio.h>


void main()
{
    FILE *fp;
    char name[300];


    // 1. Writing data into file
    fp = fopen("YogeshSanjay.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    fprintf(fp, "before sir arrives the lessons are not understandable and other students make noise and disturb class");

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("YogeshSanjay.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    fprintf(fp, "\nafter Aravind sir arrives lessons are understandable and students are very silent and not disturb the class it imporve our skills in c and marks in exam ");


    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("student.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);


}
